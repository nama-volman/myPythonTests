def decode_message(message):
    return message[1]


def find_suspicious_accounts(accounts):
    suspects = []
    for username, info in accounts.items():
        if info["failed_logins"] >= 5 and info["location"] == "UNKNOWN":
            suspects.append(username)
    return suspects


def find_final_digit(candidates):
    for candidate in candidates:
        if int(candidate[1]) == 2 and int(candidate[0]) > int(candidate[-1]):
            return candidate[-1]
    return None


message = "K4P9Z2"
accounts = {
    "neo":
      {"failed_logins": 1,
        "location": "HQ",
          "token": "N3O"},
    "trinity":
